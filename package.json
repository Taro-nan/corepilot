{
  "name": "corepilot",
  "version": "0.4.0",
  "private": true,
  "description": "CorePilot - agent-driven performance engineering for CPU algorithm libraries.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "corepilot": "./dist/entry.js",
    "corepilot-runner": "./dist/runner-entry.js",
    "phyopt": "./dist/entry.js",
    "phyopt-runner": "./dist/runner-entry.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/entry.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/*.test.ts\"",
    "postinstall": "node scripts/apply-ink-patch.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/vscode": "^1.136.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "typebox": "1.3.7",
    "undici": "^7.29.1",
    "yaml": "^2.9.1"
  }
}
