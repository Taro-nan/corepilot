{
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "../../src/client/**/*.ts", "../../src/config/**/*.ts", "../../src/backend/**/*.ts", "../../src/core/**/*.ts"]
}
