{
  "name": "corepilot-agent-vscode",
  "displayName": "CorePilot",
  "description": "Minimal IDE task client for CorePilot (thin client over the existing backend).",
  "version": "0.4.0",
  "publisher": "corepilot",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "corepilot.newExperiment",
        "title": "CorePilot: 新建任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.initTask",
        "title": "CorePilot: 优化所选文件",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.showTasks",
        "title": "CorePilot: 显示任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.cancelTask",
        "title": "CorePilot: 取消任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.openReport",
        "title": "CorePilot: 打开任务报告",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.exportTask",
        "title": "CorePilot: 导出报告",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.showCandidateDiff",
        "title": "CorePilot: 查看候选变更",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.refreshTasks",
        "title": "CorePilot: 刷新任务",
        "icon": "$(refresh)",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.optimize",
        "title": "CorePilot: 开始优化",
        "category": "CorePilot"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "corepilot.optimize",
          "when": "resourceScheme == file",
          "group": "corepilot@1"
        },
        {
          "command": "corepilot.newExperiment",
          "when": "resourceScheme == file",
          "group": "corepilot@2"
        }
      ],
      "editor/context": [
        {
          "command": "corepilot.optimize",
          "when": "editorHasSelection",
          "group": "corepilot@1"
        },
        {
          "command": "corepilot.newExperiment",
          "when": "editorHasSelection",
          "group": "corepilot@2"
        },
        {
          "command": "corepilot.initTask",
          "when": "editorTextFocus",
          "group": "corepilot@3"
        }
      ],
      "view/item/context": [
        {
          "command": "corepilot.exportTask",
          "when": "view == corepilot.tasks && viewItem == corepilot.task",
          "group": "corepilot@1"
        },
        {
          "command": "corepilot.cancelTask",
          "when": "view == corepilot.tasks && viewItem == corepilot.task",
          "group": "corepilot@2"
        },
        {
          "command": "corepilot.openReport",
          "when": "view == corepilot.tasks && viewItem == corepilot.task",
          "group": "corepilot@3"
        }
      ],
      "commandPalette": [
        {
          "command": "corepilot.newExperiment"
        },
        {
          "command": "corepilot.initTask"
        },
        {
          "command": "corepilot.showTasks"
        },
        {
          "command": "corepilot.optimize"
        },
        {
          "command": "corepilot.showCandidateDiff"
        },
        {
          "command": "corepilot.cancelTask",
          "when": "false"
        },
        {
          "command": "corepilot.openReport",
          "when": "false"
        },
        {
          "command": "corepilot.exportTask"
        },
        {
          "command": "corepilot.refreshTasks",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "corepilot",
          "title": "CorePilot",
          "icon": "media/corepilot.svg"
        }
      ]
    },
    "views": {
      "corepilot": [
        {
          "id": "corepilot.tasks",
          "name": "Tasks"
        }
      ]
    },
    "configuration": {
      "title": "CorePilot",
      "properties": {
        "corepilot.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7346",
          "description": "Backend task service base URL."
        },
        "corepilot.target": {
          "type": "string",
          "default": "",
          "description": "Configured target name (from existing config)."
        },
        "corepilot.serveCommand": {
          "type": "string",
          "default": "corepilot",
          "description": "Command used to start a managed backend (e.g. \"corepilot\", or a JSON array like [\"node\", \"/abs/path/dist/cli.js\"])."
        }
      }
    }
  }
}
