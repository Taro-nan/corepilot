{
  "name": "corepilot-agent-vscode",
  "displayName": "CorePilot",
  "description": "连接已有 CorePilot 服务，查看优化任务、报告和源码候选。",
  "version": "0.4.0",
  "publisher": "corepilot",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "corepilot.connect",
        "title": "连接 CorePilot 服务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.setToken",
        "title": "设置服务连接令牌",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.selectProject",
        "title": "选择项目",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.newExperiment",
        "title": "在网页创建优化任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.initTask",
        "title": "在网页创建优化任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.optimize",
        "title": "在网页创建优化任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.openTesting",
        "title": "在网页创建测试任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.showTasks",
        "title": "显示优化任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.showTaskDetails",
        "title": "查看任务进展",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.openReport",
        "title": "查看优化报告",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.exportTask",
        "title": "保存优化报告",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.showCandidateDiff",
        "title": "查看候选补丁",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.cancelTask",
        "title": "请求取消任务",
        "category": "CorePilot"
      },
      {
        "command": "corepilot.refreshTasks",
        "title": "刷新任务",
        "category": "CorePilot",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "corepilot.optimize",
          "when": "resourceScheme == file",
          "group": "corepilot@1"
        }
      ],
      "editor/context": [
        {
          "command": "corepilot.optimize",
          "when": "editorTextFocus",
          "group": "corepilot@1"
        }
      ],
      "view/item/context": [
        {
          "command": "corepilot.showTaskDetails",
          "when": "view == corepilot.tasks && viewItem == corepilot.workflow",
          "group": "corepilot@1"
        },
        {
          "command": "corepilot.openReport",
          "when": "view == corepilot.tasks && viewItem == corepilot.workflow",
          "group": "corepilot@2"
        },
        {
          "command": "corepilot.showCandidateDiff",
          "when": "view == corepilot.tasks && viewItem == corepilot.workflow",
          "group": "corepilot@3"
        },
        {
          "command": "corepilot.exportTask",
          "when": "view == corepilot.tasks && viewItem == corepilot.workflow",
          "group": "corepilot@4"
        },
        {
          "command": "corepilot.cancelTask",
          "when": "view == corepilot.tasks && viewItem == corepilot.workflow",
          "group": "corepilot@5"
        }
      ],
      "view/title": [
        {
          "command": "corepilot.refreshTasks",
          "when": "view == corepilot.tasks",
          "group": "navigation"
        },
        {
          "command": "corepilot.selectProject",
          "when": "view == corepilot.tasks",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "corepilot.initTask",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "corepilot",
          "title": "CorePilot",
          "icon": "media/corepilot.svg"
        }
      ]
    },
    "views": {
      "corepilot": [
        {
          "id": "corepilot.tasks",
          "name": "优化任务"
        }
      ]
    },
    "configuration": {
      "title": "CorePilot",
      "properties": {
        "corepilot.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4317",
          "description": "已运行的 CorePilot 服务地址。连接令牌通过设置服务连接令牌保存到 VS Code SecretStorage。"
        }
      }
    }
  }
}
