# Generate a private value on the server. Browser login and CLI use the same token.
COREPILOT_SERVER_TOKEN=REPLACE_WITH_A_RANDOM_PRIVATE_VALUE
# Optional: API keys referenced by project YAML, e.g. api_key: "${MODEL_API_KEY}"
# MODEL_API_KEY=...
# Optional: token referenced by project YAML, e.g. token: "${COREPILOT_RUNNER_TOKEN}"
# COREPILOT_RUNNER_TOKEN=...
# Optional: proxy shared by tools started by this service.
# HTTPS_PROXY=http://127.0.0.1:7890
