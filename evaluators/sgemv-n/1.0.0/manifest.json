    "baseline_binary": "explicit artifact path, SHA-256, and dladdr-resolved cblas_sgemv path are required",
    "runtime_resolution": "dlopen plus dlsym plus dladdr; no link-time role-specific benchmark executable",
    "mutable_dependencies": "explicit-artifact-inputs-only"
  }
}
