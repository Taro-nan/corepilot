  "qualification": {
    "record": "qualification.json",
    "requires_target_qualification": true,
    "requires_owner_approval": true
  },
  "correctness": {
    "definition": "Every declared case is executed exactly once against the candidate cblas_sgemv symbol and emits one structured PASS/FAIL measurement.",
    "inventory": "correctness/cases.json",
    "case_ids": [
      "m0_n5", "m5_n0", "m1_n1", "m3_n5", "m7_n9_odd", "lda_padded", "inc2", "inc_neg", "beta_nonzero", "alpha_zero", "alpha_neg", "vec_width", "block_boundary", "medium_127x129", "b16_m15", "b16_m16", "b16_m17", "b16_m31", "b16_m32", "b16_m33", "b32_m31", "b32_m32", "b32_m33", "b32_m63", "b32_m64", "b32_m65", "n_block_3", "n_block_4", "n_block_5"
    ],
    "command": {
      "executable": "bash",
      "script": "scripts/run-correctness.sh",
      "arguments": ["case_id", "artifact_path", "m", "n", "lda", "incx", "incy", "alpha", "beta", "threads", "seed", "runtime_root"],
      "measurement_prefix": "PHYOPT_MEASUREMENT"
    },
    "reference": {
      "implementation": "correctness/sgemv_correctness_formal.c",
      "accumulation": "scalar IEEE-754 binary64 accumulation followed by float32 result comparison",
      "qualification_required": true
    },
    "tolerance": {
      "rule": "abs(observed-reference) <= absolute + relative * abs(reference)",
      "absolute": 0.0001,
      "relative": 0.0001,
      "qualification_required": true
    }
  },
  "performance": {
    "definition": "Baseline and Candidate are measured live with the same evaluator-built executable, workload, sampling policy, resource declaration, and Runner machine context.",
    "inventory": "benchmark/workloads.json",
    "workload_ids": [
      "square_4096_t1", "square_4096_t8", "square_4096_t16", "wide_1024x16384_t1", "wide_1024x16384_t8", "wide_1024x16384_t16", "tall_16384x1024_t1", "tall_16384x1024_t8", "tall_16384x1024_t16", "small_512_t1", "large_8192_t16", "large_16384_t8", "b16_15", "b16_16", "b16_17", "b32_2047", "b32_2048", "b32_2049"
    ],
    "command": {
      "executable": "bash",
      "script": "scripts/run-performance.sh",
      "arguments": ["phase", "role", "workload_id", "artifact_path", "m", "n", "lda", "incx", "incy", "alpha", "beta", "threads", "loops", "seed", "iteration_index", "runtime_root"],
      "measurement_prefix": "PHYOPT_MEASUREMENT"
    },
    "sampling": {
      "warmup_count": 3,
      "sample_count": 7,
      "statistic": "median",
      "process_model": "one-process-per-sample"
    },
    "measurement": {
      "unit": "seconds",
      "value": "latency_seconds",
      "derived": ["median", "gflops", "speedup"],
      "raw_samples_retained": true,
      "output_schema": "benchmark/output-schema.json"
    }
  },
  "resource_requirements": {
    "cpu_set": "0-15",
    "numa_node": 0,
    "thread_counts": [1, 8, 16],
    "enforcement": {
      "threads": "NOT_ENFORCED",
      "cpu_set": "NOT_ENFORCED",
      "numa_node": "NOT_ENFORCED"
    }
  },
  "baseline_definition": {
